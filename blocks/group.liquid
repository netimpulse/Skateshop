{% doc %}
  Renders a group of theme blocks in a row or column with a fixed spacing scale.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

<div
  class="block-group block-group--{{ block.settings.layout_direction }} block-group--align-{{ block.settings.alignment }} block-group--gap-{{ block.settings.gap }}"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .block-group {
    display: flex;
    width: 100%;
  }
  .block-group--row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }
  .block-group--column {
    flex-direction: column;
  }
  .block-group--column.block-group--align-center {
    align-items: center;
    text-align: center;
  }
  .block-group--column.block-group--align-end {
    align-items: flex-end;
    text-align: end;
  }
  .block-group--gap-none {
    gap: 0;
  }
  .block-group--gap-small {
    gap: 0.75rem;
  }
  .block-group--gap-medium {
    gap: 1.5rem;
  }
  .block-group--gap-large {
    gap: 3rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gruppe",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "layout_direction",
      "label": "Anordnung",
      "default": "column",
      "options": [
        { "value": "row", "label": "Nebeneinander" },
        { "value": "column", "label": "Untereinander" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Ausrichtung",
      "default": "start",
      "visible_if": "{{ block.settings.layout_direction == 'column' }}",
      "options": [
        { "value": "start", "label": "Links" },
        { "value": "center", "label": "Mitte" },
        { "value": "end", "label": "Rechts" }
      ]
    },
    {
      "type": "select",
      "id": "gap",
      "label": "Abstand",
      "default": "medium",
      "options": [
        { "value": "none", "label": "Kein" },
        { "value": "small", "label": "Klein" },
        { "value": "medium", "label": "Mittel" },
        { "value": "large", "label": "Groß" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spalte",
      "category": "Layout",
      "settings": { "layout_direction": "column" }
    },
    {
      "name": "Zeile",
      "category": "Layout",
      "settings": { "layout_direction": "row" }
    }
  ]
}
{% endschema %}
