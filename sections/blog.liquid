{%- comment -%}
  Blog listing in a magazine style: H1 (blog.title), tag filter (blog.all_tags), article grid with an
  optional lead story, and pagination.
{%- endcomment -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}
{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign heading_id = 'BlogTitle-' | append: section.id
  assign card_ratio = section.settings.image_ratio
  if section.settings.columns_desktop == '2'
    assign card_sizes = '(min-width: 990px) 50vw, (min-width: 750px) 50vw, 100vw'
  else
    assign card_sizes = '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 100vw'
  endif
  assign featured_sizes = '(min-width: 990px) 60vw, 100vw'
-%}

<section
  class="section content-blog scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs', class: 'content-blog__breadcrumbs' %}
    {%- endif -%}

    <header class="content-blog__header">
      <p class="eyebrow eyebrow--rule">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow__index">{{ section.settings.eyebrow | escape }}</span>
        {%- endif -%}
        <span>{{ 'blog.articles_count' | t: count: blog.articles_count }}</span>
      </p>
      <h1 id="{{ heading_id }}" class="content-blog__title {{ section.settings.heading_size }}">
        {{- blog.title | escape -}}
      </h1>
      {%- if section.settings.intro != blank -%}
        <div class="content-blog__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <nav class="content-tags content-blog__tags" aria-label="{{ 'blog.filter_label' | t }}" data-testid="blog-tags">
        <ul class="content-tags__list" role="list">
          <li>
            <a
              class="content-tags__link"
              href="{{ blog.url }}"
              {% if current_tags == blank %}
                aria-current="page"
              {% endif %}
            >
              {{- 'blog.all_posts' | t -}}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a
                class="content-tags__link"
                href="{{ blog.url }}/tagged/{{ tag | handle }}"
                {% if current_tags contains tag %}
                  aria-current="page"
                {% endif %}
              >
                {{- tag | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.articles_per_page -%}
      {%- if blog.articles.size == 0 -%}
        <p class="content-blog__empty">{{ 'blog.empty' | t }}</p>
      {%- else -%}
        <ul
          class="content-blog__grid content-blog__grid--cols-{{ section.settings.columns_desktop }}"
          role="list"
          data-testid="blog-grid"
        >
          {%- for article in blog.articles -%}
            {%- liquid
              assign featured = false
              if section.settings.lead_story and forloop.first and paginate.current_page == 1
                assign featured = true
              endif
              assign card_title_id = 'BlogCard-' | append: section.id | append: '-' | append: article.id
              assign card_alt = article.image.alt | default: article.title
              if featured
                assign image_sizes = featured_sizes
              else
                assign image_sizes = card_sizes
              endif
            -%}
            <li class="content-blog__item{% if featured %} content-blog__item--featured{% endif %}">
              <article class="content-card{% if featured %} content-card--featured{% endif %}" aria-labelledby="{{ card_title_id }}">
                <div class="content-card__media">
                  {% render 'image',
                    image: article.image,
                    url: article.url,
                    alt: card_alt,
                    ratio: card_ratio,
                    sizes: image_sizes,
                    widths: '360, 540, 720, 960, 1200, 1600',
                    max_width: 1600,
                    placeholder: 'generic',
                    placeholder_label: article.title
                  %}
                  {%- if featured -%}
                    <span class="badge badge--sticker badge--new content-card__sticker">{{ 'blog.featured_label' | t }}</span>
                  {%- endif -%}
                </div>
                <div class="content-card__body">
                  {%- liquid
                    assign date_tag = article.published_at | time_tag: format: 'date'
                    assign author_name = article.author | escape
                    assign show_author = false
                    if section.settings.show_author and author_name != blank
                      assign show_author = true
                    endif
                  -%}
                  <p class="content-card__meta label-mono">
                    {%- if section.settings.show_date and show_author -%}
                      <span>{{ 'blog.article_metadata_html' | t: date: date_tag, author: author_name }}</span>
                    {%- elsif section.settings.show_date -%}
                      <span>{{ date_tag }}</span>
                    {%- elsif show_author -%}
                      <span>{{ author_name }}</span>
                    {%- endif -%}
                    {%- if article.tags.size > 0 -%}
                      <span class="content-card__tag">{{ article.tags.first | escape }}</span>
                    {%- endif -%}
                  </p>
                  <h2 id="{{ card_title_id }}" class="content-card__title {% if featured %}h2{% else %}h4{% endif %}">
                    <a class="content-card__link" href="{{ article.url }}">{{ article.title | escape }}</a>
                  </h2>
                  {%- if section.settings.show_excerpt -%}
                    {%- liquid
                      if featured
                        assign excerpt_words = 48
                      else
                        assign excerpt_words = 24
                      endif
                      assign excerpt = article.excerpt_or_content | strip_html | strip | truncatewords: excerpt_words
                    -%}
                    {%- if excerpt != blank -%}
                      <p class="content-card__excerpt">{{ excerpt }}</p>
                    {%- endif -%}
                  {%- endif -%}
                  <span class="content-card__more link-mono" aria-hidden="true">
                    {{- 'general.read_more' | t -}}
                    {% render 'icon', name: 'arrow-right' %}
                  </span>
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        {%- assign current_page = paginate.current_page | append: '' -%}
        <nav class="content-pagination" aria-label="{{ 'accessibility.pagination' | t }}" data-testid="blog-pagination">
          <ul class="content-pagination__list" role="list">
            {%- if paginate.previous -%}
              <li>
                <a
                  class="content-pagination__link content-pagination__link--arrow"
                  href="{{ paginate.previous.url }}"
                  aria-label="{{ 'pages.pagination.previous' | t }}"
                >
                  {% render 'icon', name: 'arrow-left' %}
                </a>
              </li>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a
                    class="content-pagination__link"
                    href="{{ part.url }}"
                    aria-label="{{ 'pages.pagination.page' | t: page: part.title }}"
                  >
                    {{- part.title -}}
                  </a>
                {%- elsif part.title == current_page -%}
                  <span class="content-pagination__link content-pagination__link--current" aria-current="page">
                    {{- part.title -}}
                  </span>
                {%- else -%}
                  <span class="content-pagination__gap">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if paginate.next -%}
              <li>
                <a
                  class="content-pagination__link content-pagination__link--arrow"
                  href="{{ paginate.next.url }}"
                  aria-label="{{ 'pages.pagination.next' | t }}"
                >
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog",
  "enabled_on": {
    "templates": ["blog"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Kopfbereich"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Brotkrumen anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label über der Überschrift",
      "info": "Zum Beispiel „Journal“. Die Anzahl der Beiträge steht immer daneben."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Größe der Überschrift",
      "options": [
        { "value": "h1", "label": "Mittel" },
        { "value": "h-display", "label": "Groß (Display)" }
      ],
      "default": "h-display"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Einleitung"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Themen-Filter (Tags) anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Beiträge"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Beiträge pro Seite",
      "min": 3,
      "max": 24,
      "step": 1,
      "default": 9
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Spalten (Desktop)",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "checkbox",
      "id": "lead_story",
      "label": "Neuesten Beitrag als Titelstory hervorheben",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "4-3", "label": "Quer (4:3)" },
        { "value": "3-2", "label": "Quer (3:2)" },
        { "value": "1-1", "label": "Quadratisch" },
        { "value": "4-5", "label": "Hoch (4:5)" }
      ],
      "default": "4-3"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Datum anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Autor anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Auszug anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
