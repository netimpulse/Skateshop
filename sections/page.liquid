{%- comment -%}
  Main section of page templates (shipping, returns, about, size guide, brands intro, contact intro).
  Renders breadcrumbs, the only H1 (page.title), an optional intro, an optional image, page.content
  and any theme blocks (group/text) the merchant adds below the content.
{%- endcomment -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}
{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign heading_id = 'PageTitle-' | append: section.id
  if section.settings.width == 'wide'
    assign width_class = 'page-width'
    assign image_sizes = '(min-width: 1440px) 1376px, calc(100vw - 32px)'
  else
    assign width_class = 'page-width page-width--narrow'
    assign image_sizes = '(min-width: 990px) 832px, calc(100vw - 32px)'
  endif
  assign image_alt = section.settings.image.alt | default: page.title
-%}

<section
  class="section content-page scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="{{ width_class }}">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs', class: 'content-page__breadcrumbs' %}
    {%- endif -%}

    <header class="content-page__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="{{ heading_id }}" class="content-page__title {{ section.settings.heading_size }}">
        {{- page.title | escape -}}
      </h1>
      {%- if section.settings.intro != blank -%}
        <div class="content-page__intro rte">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    {%- if section.settings.image != blank -%}
      <figure class="content-page__figure">
        {% render 'image',
          image: section.settings.image,
          alt: image_alt,
          ratio: section.settings.image_ratio,
          sizes: image_sizes,
          widths: '480, 720, 960, 1280, 1600, 2000',
          max_width: 2000
        %}
      </figure>
    {%- endif -%}

    {%- if section.settings.show_content and page.content != blank -%}
      <div class="content-page__content rte{% if section.settings.lead_paragraph %} content-page__content--lead{% endif %}">
        {{ page.content }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="content-page__blocks">
        {% content_for 'blocks' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Seiteninhalt",
  "enabled_on": {
    "templates": ["page"]
  },
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "header",
      "content": "Kopfbereich"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Brotkrumen anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label über der Überschrift",
      "info": "Mono-Label, z. B. „Service“. Leer lassen zum Ausblenden."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Größe der Überschrift",
      "options": [
        { "value": "h2", "label": "Klein" },
        { "value": "h1", "label": "Mittel" },
        { "value": "h-display", "label": "Groß (Display)" }
      ],
      "default": "h1"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Einleitung",
      "info": "Gilt für alle Seiten mit dieser Vorlage. Für seitenbezogene Einleitungen den ersten Absatz hervorheben."
    },
    {
      "type": "header",
      "content": "Inhalt"
    },
    {
      "type": "checkbox",
      "id": "show_content",
      "label": "Seiteninhalt anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "lead_paragraph",
      "label": "Ersten Absatz als Einleitung hervorheben",
      "default": true
    },
    {
      "type": "select",
      "id": "width",
      "label": "Inhaltsbreite",
      "options": [
        { "value": "narrow", "label": "Schmal (Lesebreite)" },
        { "value": "wide", "label": "Seitenbreite" }
      ],
      "default": "narrow"
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Optional, erscheint zwischen Kopfbereich und Inhalt."
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "natural", "label": "Original" },
        { "value": "16-9", "label": "Breit (16:9)" },
        { "value": "21-9", "label": "Panorama (21:9)" },
        { "value": "3-2", "label": "Quer (3:2)" }
      ],
      "default": "16-9"
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Seiteninhalt"
    }
  ]
}
{% endschema %}
