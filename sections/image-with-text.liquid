{%- comment -%}
  Image next to text for content pages: image left/right (desktop), image first/last (mobile), heading, text, buttons.
{%- endcomment -%}
{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}
{% render 'section-style', section_id: section.id, padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}

{%- liquid
  assign s = section.settings
  assign heading_id = 'Heading-' | append: section.id
  assign classes = 'image-with-text--' | append: s.layout | append: ' image-with-text--mobile-' | append: s.mobile_layout | append: ' image-with-text--align-' | append: s.vertical_alignment
-%}

<section
  class="section image-with-text {{ classes }} scheme color-{{ s.color_scheme }}"
  data-section-id="{{ section.id }}"
  {% if s.heading != blank %}
    aria-labelledby="{{ heading_id }}"
  {% endif %}
>
  <div class="page-width image-with-text__inner">
    <div class="image-with-text__media-col">
      {% render 'image',
        image: s.image,
        sizes: '(min-width: 990px) 50vw, 100vw',
        widths: '360, 540, 720, 900, 1080, 1296, 1512, 1800',
        ratio: s.image_ratio,
        class: 'image-with-text__media',
        placeholder: 'generic'
      %}
    </div>

    <div class="image-with-text__content">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ s.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="image-with-text__heading {{ s.heading_size }}" id="{{ heading_id }}">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <div class="image-with-text__text rte">{{ s.text }}</div>
      {%- endif -%}
      {%- if s.button_label != blank and s.button_link != blank or s.button_label_2 != blank and s.button_link_2 != blank -%}
        <div class="rich-text__actions">
          {%- if s.button_label != blank and s.button_link != blank -%}
            <a class="button" href="{{ s.button_link }}">{{ s.button_label | escape }}</a>
          {%- endif -%}
          {%- if s.button_label_2 != blank and s.button_link_2 != blank -%}
            <a class="button button--secondary" href="{{ s.button_link_2 }}">{{ s.button_label_2 | escape }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bild mit Text",
  "class": "section-image-with-text",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "4-5", "label": "Hochformat 4:5" },
        { "value": "1-1", "label": "Quadrat" },
        { "value": "4-3", "label": "Querformat 4:3" },
        { "value": "natural", "label": "Original" }
      ],
      "default": "4-5"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rubrik"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bild mit Text"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Größe der Überschrift",
      "options": [
        { "value": "h3", "label": "Klein" },
        { "value": "h2", "label": "Mittel" },
        { "value": "h1", "label": "Groß" }
      ],
      "default": "h2"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Kombiniere ein starkes Bild mit ein paar Sätzen zu deinem Produkt, deiner Crew oder deinem Laden.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 – Text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 – Link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 – Text"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 – Link"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Bild auf Desktop",
      "options": [
        { "value": "image-left", "label": "Links" },
        { "value": "image-right", "label": "Rechts" }
      ],
      "default": "image-left"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Bild auf Mobilgeräten",
      "options": [
        { "value": "image-first", "label": "Über dem Text" },
        { "value": "text-first", "label": "Unter dem Text" }
      ],
      "default": "image-first"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Text vertikal",
      "options": [
        { "value": "top", "label": "Oben" },
        { "value": "center", "label": "Mitte" },
        { "value": "bottom", "label": "Unten" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Bild mit Text"
    }
  ]
}
{% endschema %}
