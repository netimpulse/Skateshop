{% doc %}
  Responsive image inside an aspect-ratio media box. Falls back to the shop-style placeholder when
  no image is given, so there is never a broken image.

  @param {image} [image] - Image object (product media, image_picker setting, collection image …)
  @param {string} [url] - Optional link target; wraps the media box in a link
  @param {string} [alt] - Alt text override (defaults to image.alt)
  @param {string} [sizes] - sizes attribute, e.g. "(min-width: 990px) 25vw, 50vw"
  @param {string} [widths] - Comma-separated srcset widths
  @param {number} [max_width] - Largest rendered width (default 1800)
  @param {boolean} [eager] - Load eagerly with high fetch priority (only for the LCP image)
  @param {string} [ratio] - CSS aspect ratio, e.g. "4 / 5"; "natural" uses the image's own ratio
  @param {string} [fit] - cover | contain
  @param {string} [class] - Extra class on the media box
  @param {string} [placeholder] - Placeholder kind for placeholder-skate
  @param {string} [placeholder_label] - Accessible placeholder label

  @example
  {% render 'image', image: section.settings.image, sizes: '100vw', eager: true, ratio: '16 / 9' %}
{% enddoc %}

{%- liquid
  assign max_width = max_width | default: 1800
  assign widths = widths | default: '360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048'
  assign sizes = sizes | default: '100vw'
  assign fit_class = ''
  if fit == 'contain'
    assign fit_class = ' media--contain'
  endif

  if eager
    assign loading = 'eager'
    assign priority = 'high'
  else
    assign loading = 'lazy'
    assign priority = 'auto'
  endif

  assign image_alt = alt | default: image.alt | escape
-%}

{%- capture media -%}
  {%- if image -%}
    {{
      image
      | image_url: width: max_width
      | image_tag: widths: widths, sizes: sizes, loading: loading, fetchpriority: priority, alt: image_alt
    }}
  {%- else -%}
    {% render 'placeholder-skate', kind: placeholder, label: placeholder_label %}
  {%- endif -%}
{%- endcapture -%}

{%- if url != blank -%}
  <a href="{{ url }}" class="media{{ fit_class }} {{ class }}" data-ratio="{{ ratio | default: 'default' | handleize }}" tabindex="-1" aria-hidden="true">{{ media }}</a>
{%- else -%}
  <div class="media{{ fit_class }} {{ class }}" data-ratio="{{ ratio | default: 'default' | handleize }}">{{ media }}</div>
{%- endif -%}
