{% doc %}
  Product card: image (second image on hover), sticker badges, vendor, title, price, color swatches, quick add.
  Always shows an image – the shop-style placeholder when the product has none.

  @param {product} product - The product
  @param {string} [layout] - default | horizontal
  @param {string} [sizes] - sizes attribute for the image
  @param {string} [heading_tag] - Title tag, default h3
  @param {boolean} [show_quick_add] - Override the theme setting
  @param {number} [index] - Position in the list (stagger for reveal)

  @example
  {% render 'product-card', product: product, sizes: '(min-width: 990px) 25vw, 50vw' %}
{% enddoc %}

{%- liquid
  assign layout = layout | default: 'default'
  assign heading_tag = heading_tag | default: 'h3'
  assign sizes = sizes | default: '(min-width: 1200px) 340px, (min-width: 750px) 33vw, 50vw'
  if show_quick_add == nil
    assign show_quick_add = settings.card_quick_add
  endif

  assign primary = product.featured_media
  assign secondary = nil
  if settings.card_show_second_image and product.media.size > 1
    for media in product.media
      if media.media_type == 'image' and media.id != primary.id
        assign secondary = media
        break
      endif
    endfor
  endif

  assign kind = product.metafields.custom.builder_category.value | default: product.type | handleize
  case kind
    when 'deck', 'decks'
      assign kind = 'deck'
    when 'truck', 'trucks', 'achsen'
      assign kind = 'trucks'
    when 'wheel', 'wheels', 'rollen'
      assign kind = 'wheels'
    when 'bearing', 'bearings', 'kugellager'
      assign kind = 'bearings'
    when 'griptape', 'grip'
      assign kind = 'griptape'
    when 'hardware', 'schrauben'
      assign kind = 'hardware'
    when 'riser', 'riser-pads'
      assign kind = 'riser'
    when 'complete', 'completes', 'complete-skateboard'
      assign kind = 'complete'
    else
      assign kind = 'generic'
  endcase

  assign color_option = nil
  if settings.card_show_swatches
    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name == 'farbe' or option_name == 'color' or option_name == 'colour'
        assign color_option = option
        break
      endif
    endfor
  endif

  assign fit_class = ''
  if settings.card_image_fit == 'contain'
    assign fit_class = ' media--contain'
  endif
-%}

<article
  class="product-card product-card--{{ layout }} reveal"
  data-product-card
  data-product-id="{{ product.id }}"
  {% if index %}
    data-reveal-index="{{ index | modulo: 4 }}"
  {% endif %}
>
  <div class="product-card__media-wrap">
    <a
      href="{{ product.url }}"
      class="product-card__media media{{ fit_class }}{% if secondary %} product-card__media--hover{% endif %}"
      tabindex="-1"
      aria-hidden="true"
    >
      {%- if primary -%}
        {{
          primary.preview_image
          | image_url: width: 1200
          | image_tag:
            widths: '240, 360, 480, 640, 800, 1000, 1200',
            sizes: sizes,
            loading: 'lazy',
            class: 'product-card__image product-card__image--primary',
            alt: primary.alt
        }}
        {%- if secondary -%}
          {{
            secondary.preview_image
            | image_url: width: 1200
            | image_tag:
              widths: '240, 360, 480, 640, 800, 1000, 1200',
              sizes: sizes,
              loading: 'lazy',
              class: 'product-card__image product-card__image--secondary',
              alt: ''
          }}
        {%- endif -%}
      {%- else -%}
        {% render 'placeholder-skate', kind: kind, label: product.title %}
      {%- endif -%}
    </a>

    {%- if settings.card_show_badges -%}
      <div class="product-card__badges">
        {%- render 'product-badge', product: product -%}
      </div>
    {%- endif -%}

    {%- if show_quick_add -%}
      <div class="product-card__quick-add">
        {%- render 'quick-add', product: product -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info">
    {%- if settings.card_show_vendor and product.vendor != blank -%}
      <p class="product-card__vendor label-mono">
        <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
        {{ product.vendor | escape }}
      </p>
    {%- endif -%}

    <{{ heading_tag }} class="product-card__title">
      <a href="{{ product.url }}" class="product-card__link">{{ product.title | escape }}</a>
    </{{ heading_tag }}>

    {%- if layout == 'horizontal' and product.description != blank -%}
      <p class="product-card__excerpt text-muted text-small">{{ product.description | strip_html | truncatewords: 18 }}</p>
    {%- endif -%}

    {% render 'price', product: product, class: 'product-card__price' %}

    {%- if color_option -%}
      <div class="product-card__swatches swatch-list">
        <span class="visually-hidden">{{ 'products.card.colors' | t }}:</span>
        {%- for value in color_option.values limit: settings.card_swatch_limit -%}
          {%- render 'swatch', value: value -%}
        {%- endfor -%}
        {%- assign more = color_option.values.size | minus: settings.card_swatch_limit -%}
        {%- if more > 0 -%}
          <span class="product-card__more label-mono">{{ 'products.card.more_colors' | t: count: more }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
