{% doc %}
  Mobile navigation drawer (< 990px): <dialog class="drawer drawer--left" id="MenuDrawer">, opened by the
  burger via [data-dialog-open="MenuDrawer"] (theme.js handles showModal, Escape, backdrop and focus return).
  Sub-levels are nested <details> accordions. Footer: account link, CTA button, social links.

  @param {object} menu - Link list for the navigation
  @param {string} [highlight] - Lower-cased title of the highlighted menu item
  @param {string} section_id - Header section id (for unique ids)
  @param {boolean} [show_account] - Show the account link
  @param {string} [account_label] - Account link label
  @param {string} [cta_label] - CTA button label
  @param {string} [cta_link] - CTA button URL

  @example
  {% render 'header-drawer', menu: menu, highlight: 'konfigurator', section_id: section.id, show_account: true, account_label: 'Konto', cta_label: 'Board bauen', cta_link: cta_link %}
{% enddoc %}

{%- liquid
  assign menu_title = 'header.drawer.title' | t
  assign close_label = 'accessibility.close_menu' | t
  assign nav_label = 'header.nav_label' | t
  assign title_id = 'MenuDrawerTitle-' | append: section_id
-%}

<dialog
  id="MenuDrawer"
  class="drawer drawer--left menu-drawer"
  aria-labelledby="{{ title_id }}"
  data-backdrop-close
  data-testid="menu-drawer"
>
  <div class="drawer__header menu-drawer__header">
    <p id="{{ title_id }}" class="drawer__title">{{ menu_title }}</p>
    <button type="button" class="icon-button menu-drawer__close" data-dialog-close aria-label="{{ close_label | escape }}">
      {%- render 'icon', name: 'close' -%}
    </button>
  </div>

  <div class="drawer__body menu-drawer__body">
    {%- if menu.links.size > 0 -%}
      <nav class="menu-drawer__nav" aria-label="{{ nav_label | escape }}">
        <ul class="menu-drawer__list" role="list">
          {%- for link in menu.links -%}
            {%- liquid
              assign link_title = link.title | strip | downcase
              assign is_highlight = false
              if highlight != blank and link_title == highlight
                assign is_highlight = true
              endif
              assign index_padded = forloop.index | prepend: '0' | slice: -2, 2
            -%}
            <li class="menu-drawer__item">
              {%- if link.links.size > 0 -%}
                {%- assign view_all_label = 'header.mega.view_all' | t: title: link.title -%}
                <details class="menu-drawer__details"{% if link.child_active %} open{% endif %}>
                  <summary class="menu-drawer__link{% if is_highlight %} menu-drawer__link--highlight{% endif %}">
                    <span class="menu-drawer__index" aria-hidden="true">{{ index_padded }}</span>
                    <span class="menu-drawer__label">{{ link.title | escape }}</span>
                    {%- render 'icon', name: 'chevron-down', class: 'menu-drawer__toggle' -%}
                  </summary>
                  <ul class="menu-drawer__sublist" role="list">
                    <li>
                      <a href="{{ link.url }}" class="menu-drawer__sublink menu-drawer__sublink--all">
                        <span>{{ view_all_label }}</span>
                        {%- render 'icon', name: 'arrow-right' -%}
                      </a>
                    </li>
                    {%- for child in link.links -%}
                      <li>
                        {%- if child.links.size > 0 -%}
                          {%- assign child_all_label = 'header.mega.view_all' | t: title: child.title -%}
                          <details class="menu-drawer__details menu-drawer__details--nested"{% if child.child_active %} open{% endif %}>
                            <summary class="menu-drawer__sublink">
                              <span>{{ child.title | escape }}</span>
                              {%- render 'icon', name: 'chevron-down', class: 'menu-drawer__toggle' -%}
                            </summary>
                            <ul class="menu-drawer__sublist menu-drawer__sublist--nested" role="list">
                              <li>
                                <a href="{{ child.url }}" class="menu-drawer__sublink menu-drawer__sublink--all">
                                  <span>{{ child_all_label }}</span>
                                  {%- render 'icon', name: 'arrow-right' -%}
                                </a>
                              </li>
                              {%- for grandchild in child.links -%}
                                <li>
                                  <a
                                    href="{{ grandchild.url }}"
                                    class="menu-drawer__sublink"
                                    {% if grandchild.current %}
                                      aria-current="page"
                                    {% endif %}
                                  >
                                    {{- grandchild.title | escape -}}
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </details>
                        {%- else -%}
                          <a
                            href="{{ child.url }}"
                            class="menu-drawer__sublink"
                            {% if child.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{- child.title | escape -}}
                          </a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a
                  href="{{ link.url }}"
                  class="menu-drawer__link{% if is_highlight %} menu-drawer__link--highlight{% endif %}"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  <span class="menu-drawer__index" aria-hidden="true">{{ index_padded }}</span>
                  <span class="menu-drawer__label">{{ link.title | escape }}</span>
                  {%- render 'icon', name: 'arrow-right', class: 'menu-drawer__toggle' -%}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>

  <div class="drawer__footer menu-drawer__footer">
    {%- if show_account -%}
      <a href="{{ routes.account_url }}" class="menu-drawer__account">
        {%- render 'icon', name: 'account' -%}
        <span>{{ account_label }}</span>
      </a>
    {%- endif -%}
    {%- if cta_label != blank and cta_link != blank -%}
      <a href="{{ cta_link }}" class="button button--full menu-drawer__cta">
        <span>{{ cta_label | escape }}</span>
        {%- render 'icon', name: 'arrow-right' -%}
      </a>
    {%- endif -%}
    {%- render 'social-links', class: 'menu-drawer__social' -%}
  </div>
</dialog>
