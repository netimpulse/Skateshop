{%- comment -%}
  404 page: retro display "404", H1, text, search form and a short list of helpful links
  (menu from settings, otherwise home, board builder and decks when they exist).
{%- endcomment -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}
{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign heading_id = 'NotFoundTitle-' | append: section.id
  assign links_heading_id = 'NotFoundLinks-' | append: section.id
  assign search_id = 'NotFoundSearch-' | append: section.id

  assign heading = section.settings.heading
  if heading == blank
    assign heading = '404.heading' | t
  endif
  assign display_code = section.settings.display_text | default: '404'

  assign menu = section.settings.menu
  assign builder_page = section.settings.builder_page
  assign decks_collection = section.settings.collection
-%}

<section
  class="section content-404 scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width">
    <div class="content-404__inner">
      <p class="content-404__eyebrow eyebrow eyebrow--rule">{{ '404.eyebrow' | t }}</p>

      <p class="content-404__code" aria-hidden="true">
        <span class="content-404__code-text" data-text="{{ display_code | escape }}">{{ display_code | escape }}</span>
      </p>
      <div class="tri-stripe content-404__stripe" aria-hidden="true"><span></span></div>

      <h1 id="{{ heading_id }}" class="content-404__title h2">{{ heading | escape }}</h1>

      <div class="content-404__text rte">
        {%- if section.settings.text != blank -%}
          {{ section.settings.text }}
        {%- else -%}
          <p>{{ '404.text' | t }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.show_search -%}
        <form
          action="{{ routes.search_url }}"
          method="get"
          role="search"
          class="content-404__search"
          data-testid="notfound-search"
        >
          <label class="field__label" for="{{ search_id }}">{{ '404.search_label' | t }}</label>
          <div class="content-404__search-row">
            <input
              class="field__input content-404__search-input"
              type="search"
              id="{{ search_id }}"
              name="q"
              placeholder="{{ 'search.placeholder' | t }}"
              autocomplete="off"
              autocapitalize="off"
              spellcheck="false"
            >
            <input type="hidden" name="options[prefix]" value="last">
            <button type="submit" class="button button--ink">
              {% render 'icon', name: 'search' %}
              <span>{{ 'search.submit' | t }}</span>
            </button>
          </div>
        </form>
      {%- endif -%}

      <nav class="content-404__links" aria-labelledby="{{ links_heading_id }}">
        <h2 id="{{ links_heading_id }}" class="content-404__links-title label-mono">{{ '404.links_heading' | t }}</h2>
        <ul class="content-404__list" role="list">
          {%- if menu != blank and menu.links.size > 0 -%}
            {%- for link in menu.links -%}
              <li>
                <a class="content-404__link" href="{{ link.url }}">
                  <span>{{ link.title | escape }}</span>
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            <li>
              <a class="content-404__link" href="{{ routes.root_url }}">
                <span>{{ 'general.home' | t }}</span>
                {% render 'icon', name: 'arrow-right' %}
              </a>
            </li>
            {%- if builder_page != blank -%}
              <li>
                <a class="content-404__link" href="{{ builder_page.url }}">
                  <span>{{ builder_page.title | escape }}</span>
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </li>
            {%- endif -%}
            {%- if decks_collection != blank -%}
              <li>
                <a class="content-404__link" href="{{ decks_collection.url }}">
                  <span>{{ decks_collection.title | escape }}</span>
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              </li>
            {%- endif -%}
            <li>
              <a class="content-404__link" href="{{ routes.all_products_collection_url }}">
                <span>{{ '404.back_to_shopping' | t }}</span>
                {% render 'icon', name: 'arrow-right' %}
              </a>
            </li>
          {%- endif -%}
        </ul>
      </nav>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "404-Seite",
  "enabled_on": {
    "templates": ["404"]
  },
  "settings": [
    {
      "type": "text",
      "id": "display_text",
      "label": "Große Display-Zahl",
      "default": "404"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "info": "Leer lassen für den Standardtext."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Leer lassen für den Standardtext."
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Suchfeld anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menü",
      "info": "Ohne Menü: Startseite, Konfigurator, Decks und Alle Produkte."
    },
    {
      "type": "page",
      "id": "builder_page",
      "label": "Konfigurator-Seite"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Kategorie-Link",
      "info": "Zum Beispiel die Collection „Decks“."
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
