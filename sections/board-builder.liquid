{%- comment -%}
  Skateboard builder (/pages/skateboard-builder). Steps are blocks – each points to a collection
  (builder-decks, builder-trucks, …). Products, filters and compatibility are resolved client-side from
  {collection.url}?view=builder-data (templates/collection.builder-data.liquid).
{%- endcomment -%}

{{ 'board-builder.css' | asset_url | stylesheet_tag }}
{% render 'section-style', section_id: section.id, padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign valid_steps = 0
  for block in step_blocks
    if block.settings.collection != blank
      assign valid_steps = valid_steps | plus: 1
    endif
  endfor
  assign summary_label = 'builder.parts.summary' | t
-%}

<section
  class="section bb scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="Heading-{{ section.id }}"
>
  <div class="page-width">
    <div class="bb-head">
      {%- if section.settings.show_breadcrumbs -%}
        {% render 'breadcrumbs', class: 'bb-head__crumbs' %}
      {%- endif -%}
      <div class="bb-head__row">
        <div class="bb-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h1 id="Heading-{{ section.id }}" class="bb-head__title h1">{{ section.settings.heading }}</h1>
          {%- if section.settings.intro != blank -%}
            <div class="bb-head__intro rte text-muted">{{ section.settings.intro }}</div>
          {%- endif -%}
        </div>
        <button type="button" class="button button--secondary button--small bb-head__reset" data-bb-reset>
          {{- 'builder.reset' | t -}}
        </button>
      </div>
    </div>

    {%- if valid_steps == 0 -%}
      <div class="bb-empty form-message">
        {%- render 'icon', name: 'info' -%}
        <p>{{ 'builder.editor.no_steps' | t }}</p>
      </div>
    {%- else -%}
      <board-builder class="bb-app" data-section-id="{{ section.id }}">
        <script type="application/json" data-builder-config>
          {
            "sectionId": {{ section.id | json }},
            "steps": [
              {%- assign first_step = true -%}
              {%- for block in step_blocks -%}
                {%- if block.settings.collection == blank -%}{%- continue -%}{%- endif -%}
                {%- unless first_step -%},{%- endunless -%}
                {%- assign first_step = false -%}
                {
                  "part": {{ block.settings.part | json }},
                  "label": {{ block.settings.label | json }},
                  "title": {{ block.settings.title | json }},
                  "intro": {{ block.settings.intro | json }},
                  "url": {{ block.settings.collection.url | json }},
                  "filters": {{ block.settings.filters | json }},
                  "required": {{ block.settings.required | json }}
                }
              {%- endfor -%}
            ],
            "riser": {% if section.settings.riser_collection != blank %}{ "url": {{ section.settings.riser_collection.url | json }} }{% else %}null{% endif %},
            "rules": {
              "riserThresholdMm": {{ section.settings.riser_threshold }},
              "truckTolerance": {{ section.settings.truck_tolerance | divided_by: 1000.0 }}
            },
            "defaultAvailableOnly": {{ section.settings.available_only | json }},
            "strings": {
              "parts": {
                "deck": {{ 'builder.parts.deck' | t | json }},
                "trucks": {{ 'builder.parts.trucks' | t | json }},
                "wheels": {{ 'builder.parts.wheels' | t | json }},
                "bearings": {{ 'builder.parts.bearings' | t | json }},
                "griptape": {{ 'builder.parts.griptape' | t | json }},
                "hardware": {{ 'builder.parts.hardware' | t | json }},
                "riser": {{ 'builder.parts.riser' | t | json }},
                "summary": {{ summary_label | json }}
              },
              "stepOf": {{ 'builder.step_of' | t | json }},
              "stepDone": {{ 'builder.step_done' | t | json }},
              "stepOpen": {{ 'builder.step_open' | t | json }},
              "stepCurrent": {{ 'builder.step_current' | t | json }},
              "notSelected": {{ 'builder.not_selected' | t | json }},
              "optional": {{ 'builder.optional' | t | json }},
              "continueTo": {{ 'builder.continue_to' | t | json }},
              "toSummary": {{ 'builder.to_summary' | t | json }},
              "resetConfirm": {{ 'builder.reset_confirm' | t | json }},
              "select": {{ 'builder.select' | t | json }},
              "selected": {{ 'builder.selected' | t | json }},
              "change": {{ 'builder.change' | t | json }},
              "remove": {{ 'builder.remove' | t | json }},
              "details": {{ 'builder.details' | t | json }},
              "soldOut": {{ 'builder.sold_out' | t | json }},
              "loading": {{ 'builder.loading' | t | json }},
              "loadError": {{ 'builder.load_error' | t | json }},
              "retry": {{ 'builder.retry' | t | json }},
              "emptyStep": {{ 'builder.empty_step' | t | json }},
              "noResults": {{ 'builder.no_results' | t | json }},
              "clearFilters": {{ 'builder.clear_filters' | t | json }},
              "results": {{ 'builder.results' | t | json }},
              "onlyFit": {{ 'builder.only_fit' | t | json }},
              "chosen": {{ 'builder.chosen' | t | json }},
              "partUnavailable": {{ 'builder.part_unavailable' | t | json }},
              "previewSummary": {{ 'builder.preview.summary' | t | json }},
              "previewEmpty": {{ 'builder.preview.empty' | t | json }},
              "facets": {
                "vendor": {{ 'builder.facets.vendor' | t | json }},
                "price": {{ 'builder.facets.price' | t | json }},
                "available": {{ 'builder.facets.available' | t | json }},
                "color": {{ 'builder.facets.color' | t | json }},
                "deck_width": {{ 'builder.facets.deck_width' | t | json }},
                "deck_length": {{ 'builder.facets.deck_length' | t | json }},
                "concave": {{ 'builder.facets.concave' | t | json }},
                "truck_width": {{ 'builder.facets.truck_width' | t | json }},
                "truck_height": {{ 'builder.facets.truck_height' | t | json }},
                "wheel_size": {{ 'builder.facets.wheel_size' | t | json }},
                "wheel_hardness": {{ 'builder.facets.wheel_hardness' | t | json }},
                "bearing_rating": {{ 'builder.facets.bearing_rating' | t | json }},
                "grip_style": {{ 'builder.facets.grip_style' | t | json }},
                "hardware_length": {{ 'builder.facets.hardware_length' | t | json }},
                "priceUpTo": {{ 'builder.facets.price_up_to' | t | json }},
                "priceFrom": {{ 'builder.facets.price_from' | t | json }},
                "priceRange": {{ 'builder.facets.price_range' | t | json }},
                "availableOnly": {{ 'builder.facets.available_only' | t | json }}
              },
              "rules": {
                "truck_width_hint": {{ 'builder.rules.truck_width_hint' | t | json }},
                "fits": {{ 'builder.rules.fits' | t | json }},
                "truck_too_narrow": {{ 'builder.rules.truck_too_narrow' | t | json }},
                "truck_too_wide": {{ 'builder.rules.truck_too_wide' | t | json }},
                "deck_truck_mismatch": {{ 'builder.rules.deck_truck_mismatch' | t | json }},
                "deck_needs_other_trucks": {{ 'builder.rules.deck_needs_other_trucks' | t | json }},
                "riser_hint": {{ 'builder.rules.riser_hint' | t | json }},
                "riser_badge": {{ 'builder.rules.riser_badge' | t | json }},
                "low_truck_wheel": {{ 'builder.rules.low_truck_wheel' | t | json }},
                "low_truck_wheel_badge": {{ 'builder.rules.low_truck_wheel_badge' | t | json }},
                "hardware_riser": {{ 'builder.rules.hardware_riser' | t | json }},
                "hardware_riser_badge": {{ 'builder.rules.hardware_riser_badge' | t | json }}
              },
              "riser": {
                "add": {{ 'builder.riser.add' | t | json }},
                "choose": {{ 'builder.riser.choose' | t | json }},
                "remove": {{ 'builder.riser.remove' | t | json }}
              },
              "summary": {
                "title": {{ 'builder.summary.title' | t | json }},
                "add": {{ 'builder.summary.add' | t | json }},
                "edit": {{ 'builder.summary.edit' | t | json }},
                "missing": {{ 'builder.summary.missing' | t | json }},
                "added": {{ 'builder.summary.added' | t | json }},
                "viewCart": {{ 'builder.summary.view_cart' | t | json }},
                "unavailable": {{ 'builder.summary.unavailable' | t | json }},
                "error": {{ 'builder.summary.error' | t | json }},
                "newBuild": {{ 'builder.summary.new_build' | t | json }},
                "compatTitle": {{ 'builder.summary.compat_title' | t | json }},
                "compatOk": {{ 'builder.summary.compat_ok' | t | json }},
                "part": {{ 'builder.summary.part' | t | json }},
                "product": {{ 'builder.summary.product' | t | json }},
                "price": {{ 'builder.summary.price' | t | json }},
                "total": {{ 'builder.total' | t | json }}
              }
            }
          }
        </script>

        <nav class="bb-steps" aria-label="{{ 'builder.steps_label' | t }}">
          <ol class="bb-steps__list" role="list" data-bb-stepper>
            {%- assign step_index = 0 -%}
            {%- for block in step_blocks -%}
              {%- if block.settings.collection == blank -%}{%- continue -%}{%- endif -%}
              {%- assign step_index = step_index | plus: 1 -%}
              <li class="bb-steps__item" {{ block.shopify_attributes }}>
                <button type="button" class="bb-steps__button" data-bb-goto="{{ block.settings.part }}">
                  <span class="bb-steps__num">{{ step_index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="bb-steps__label">{{ block.settings.label | escape }}</span>
                  <span class="bb-steps__state" data-bb-step-state>{{ 'builder.step_open' | t }}</span>
                </button>
              </li>
            {%- endfor -%}
            <li class="bb-steps__item bb-steps__item--summary">
              <button type="button" class="bb-steps__button" data-bb-goto="summary">
                <span class="bb-steps__num">{% render 'icon', name: 'check' %}</span>
                <span class="bb-steps__label">{{ summary_label }}</span>
                <span class="bb-steps__state" data-bb-step-state></span>
              </button>
            </li>
          </ol>
        </nav>

        <div class="bb-layout">
          <aside class="bb-aside" aria-label="{{ 'builder.preview.aside' | t }}">
            <div class="bb-aside__sticky">
              {% render 'board-preview', id: section.id %}
              <ol class="bb-legend" role="list" data-bb-legend></ol>
            </div>
          </aside>

          <div class="bb-main">
            <div class="bb-panel" data-bb-panel>
              <div class="bb-panel__head">
                <p class="eyebrow eyebrow--rule" data-bb-step-count></p>
                <h2 class="bb-panel__title h2" tabindex="-1" data-bb-step-title></h2>
                <p class="bb-panel__intro text-muted" data-bb-step-intro></p>
              </div>
              <div class="bb-hints" data-bb-hints aria-live="polite"></div>
              <div class="bb-filters" data-bb-filters></div>
              <div class="bb-toolbar">
                <p class="bb-toolbar__count label-mono" data-bb-count aria-live="polite"></p>
                <div class="bb-toolbar__sort">
                  <label class="label-mono" for="BuilderSort-{{ section.id }}">{{ 'builder.sort' | t }}</label>
                  <div class="select">
                    <select id="BuilderSort-{{ section.id }}" class="select__select" data-bb-sort>
                      <option value="featured">{{ 'builder.sort_featured' | t }}</option>
                      <option value="price-asc">{{ 'builder.sort_price_asc' | t }}</option>
                      <option value="price-desc">{{ 'builder.sort_price_desc' | t }}</option>
                      <option value="title">{{ 'builder.sort_title' | t }}</option>
                    </select>
                    {%- render 'icon', name: 'chevron-down' -%}
                  </div>
                </div>
              </div>
              <ul class="bb-grid" role="list" data-bb-list aria-busy="true"></ul>
              <div class="bb-status" data-bb-status></div>
            </div>

            <div class="bb-summary" data-bb-summary hidden></div>
          </div>
        </div>

        <div class="bb-bar color-scheme-3 scheme" data-bb-bar>
          <div class="bb-bar__inner page-width">
            <ol class="bb-bar__dots" role="list" aria-hidden="true" data-bb-dots></ol>
            <p class="bb-bar__total">
              <span class="label-mono">{{ 'builder.total' | t }}</span>
              <strong data-bb-total>{{ 0 | money }}</strong>
            </p>
            <div class="bb-bar__actions">
              <button type="button" class="button button--secondary bb-bar__prev" data-bb-prev>
                {%- render 'icon', name: 'arrow-left' -%}
                <span class="hidden-mobile">{{ 'builder.back' | t }}</span>
                <span class="visually-hidden hidden-tablet-up">{{ 'builder.back' | t }}</span>
              </button>
              <button type="button" class="button bb-bar__next" data-bb-next>
                <span data-bb-next-label>{{ 'builder.continue' | t }}</span>
                {%- render 'icon', name: 'arrow-right' -%}
              </button>
            </div>
          </div>
        </div>

        <noscript>
          <p class="form-message">{{ 'builder.noscript' | t }}</p>
        </noscript>
      </board-builder>
    {%- endif -%}
  </div>
</section>

<script type="module" src="{{ 'board-builder.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Board Builder",
  "tag": "div",
  "class": "section-board-builder",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Konfigurator · 6 Schritte" },
    { "type": "inline_richtext", "id": "heading", "label": "Überschrift", "default": "BUILD YOUR BOARD." },
    { "type": "richtext", "id": "intro", "label": "Einleitung", "default": "<p>Sechs Schritte, geprüfte Kombinationen. Deine Auswahl bleibt gespeichert, auch wenn du zurückgehst.</p>" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Breadcrumbs anzeigen", "default": true },
    { "type": "header", "content": "Produktauswahl" },
    { "type": "checkbox", "id": "available_only", "label": "Standardmäßig nur verfügbare Produkte zeigen", "default": true },
    { "type": "header", "content": "Kompatibilität" },
    {
      "type": "range",
      "id": "truck_tolerance",
      "label": "Toleranz Achsbreite zu Deckbreite (Tausendstel Zoll)",
      "info": "250 = ±0.25\". Die Regeln selbst stehen zentral in assets/board-builder-rules.js.",
      "min": 125,
      "max": 500,
      "step": 125,
      "default": 250
    },
    {
      "type": "range",
      "id": "riser_threshold",
      "label": "Riser-Hinweis ab Rollengröße",
      "min": 50,
      "max": 62,
      "step": 1,
      "unit": "mm",
      "default": 56
    },
    {
      "type": "collection",
      "id": "riser_collection",
      "label": "Riser Pads (Collection)",
      "info": "Wird beim Wheelbite-Hinweis als optionales Extra angeboten, z. B. builder-risers."
    },
    { "type": "header", "content": "Layout" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Farbschema", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "label": "Abstand oben", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom", "label": "Abstand unten", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "part",
          "label": "Bauteil",
          "options": [
            { "value": "deck", "label": "Deck" },
            { "value": "trucks", "label": "Trucks / Achsen" },
            { "value": "wheels", "label": "Wheels / Rollen" },
            { "value": "bearings", "label": "Bearings / Kugellager" },
            { "value": "griptape", "label": "Griptape" },
            { "value": "hardware", "label": "Hardware / Schrauben" }
          ],
          "default": "deck"
        },
        { "type": "text", "id": "label", "label": "Kurzname im Fortschritt", "default": "Deck" },
        { "type": "text", "id": "title", "label": "Überschrift", "default": "Wähle dein Deck" },
        { "type": "text", "id": "intro", "label": "Hinweistext" },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Alle Produkte dieser Collection stehen im Schritt zur Auswahl (z. B. builder-decks)."
        },
        {
          "type": "text",
          "id": "filters",
          "label": "Filter (kommagetrennt)",
          "info": "Leer = Standard je Bauteil. Mögliche Werte: vendor, price, available, color, deck_width, deck_length, concave, truck_width, truck_height, wheel_size, wheel_hardness, bearing_rating, grip_style, hardware_length"
        },
        { "type": "checkbox", "id": "required", "label": "Pflichtschritt", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Board Builder",
      "blocks": [
        { "type": "step", "settings": { "part": "deck", "label": "Deck", "title": "Wähle dein Deck" } },
        { "type": "step", "settings": { "part": "trucks", "label": "Trucks", "title": "Wähle deine Achsen" } },
        { "type": "step", "settings": { "part": "wheels", "label": "Wheels", "title": "Wähle deine Rollen" } },
        { "type": "step", "settings": { "part": "bearings", "label": "Bearings", "title": "Wähle deine Kugellager" } },
        { "type": "step", "settings": { "part": "griptape", "label": "Grip", "title": "Wähle dein Griptape" } },
        { "type": "step", "settings": { "part": "hardware", "label": "Hardware", "title": "Wähle deine Schrauben" } }
      ]
    }
  ]
}
{% endschema %}
