{%- comment -%}
  Collection header: breadcrumbs, H1 (collection title), short SEO text (collection.description), product count
  and an optional banner. Banner source: collection.metafields.custom.banner (file_reference image)
  → collection.image → section image.
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign banner = nil
  if section.settings.show_banner
    assign banner = collection.metafields.custom.banner.value | default: collection.image | default: section.settings.image
  endif
  assign layout = section.settings.layout
  assign count_label = 'collections.product_count' | t: count: collection.all_products_count
  assign title_class = 'h1'
  if section.settings.title_size == 'display'
    assign title_class = 'h-display'
  endif
-%}

<section
  class="section collection-header collection-header--{{ layout }}{% if banner %} collection-header--has-banner{% endif %} scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="CollectionTitle-{{ section.id }}"
  data-testid="collection-header"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs', class: 'collection-header__breadcrumbs' %}
    {%- endif -%}

    <div class="collection-header__grid">
      <div class="collection-header__text">
        {%- if section.settings.eyebrow != blank or section.settings.show_count -%}
          <p class="collection-header__meta eyebrow eyebrow--rule">
            {%- if section.settings.eyebrow != blank -%}
              <span>{{ section.settings.eyebrow | escape }}</span>
            {%- endif -%}
            {%- if section.settings.show_count -%}
              <span class="collection-header__count" data-testid="collection-count">{{ count_label }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        <h1 class="collection-header__title {{ title_class }}" id="CollectionTitle-{{ section.id }}">
          {{- collection.title | escape -}}
        </h1>

        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="collection-header__description rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>

      {%- if banner and layout == 'compact' -%}
        <div class="collection-header__side">
          {% render 'image',
            image: banner,
            alt: collection.title,
            sizes: '(min-width: 990px) 40vw, 100vw',
            ratio: '4 / 3',
            eager: true,
            class: 'collection-header__media'
          %}
        </div>
      {%- endif -%}
    </div>

    {%- if banner and layout == 'banner' -%}
      <div class="collection-header__banner">
        {% render 'image',
          image: banner,
          alt: collection.title,
          sizes: '(min-width: 1500px) 1440px, 100vw',
          ratio: section.settings.banner_ratio,
          eager: true,
          class: 'collection-header__media'
        %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kategorie-Kopf",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "compact", "label": "Kompakt (Bild rechts)" },
        { "value": "banner", "label": "Banner (breites Bild unten)" }
      ],
      "default": "compact"
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Titelgröße",
      "options": [
        { "value": "h1", "label": "Groß" },
        { "value": "display", "label": "Sehr groß" }
      ],
      "default": "h1"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker über dem Titel",
      "default": "Kategorie"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Brotkrumen anzeigen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Kategorie-Beschreibung anzeigen",
      "info": "Kurzer SEO-Text aus der Collection-Beschreibung.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Produktanzahl anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Banner"
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Banner anzeigen",
      "info": "Bildquelle: Metafeld custom.banner der Collection, sonst Collection-Bild, sonst das Bild unten.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Ersatzbild",
      "visible_if": "{{ section.settings.show_banner }}"
    },
    {
      "type": "select",
      "id": "banner_ratio",
      "label": "Banner-Format (Layout Banner)",
      "options": [
        { "value": "21 / 9", "label": "Flach (21:9)" },
        { "value": "16 / 9", "label": "Mittel (16:9)" }
      ],
      "default": "21 / 9",
      "visible_if": "{{ section.settings.show_banner and section.settings.layout == 'banner' }}"
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "Kategorie-Kopf"
    }
  ]
}
{% endschema %}
