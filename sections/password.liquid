{%- comment -%}
  Password page (layout/password.liquid): logo or shop name, H1, password message, newsletter sign-up
  (customer form, tag "newsletter") and the storefront password form behind a disclosure.
{%- endcomment -%}

{{ 'section-content.css' | asset_url | stylesheet_tag }}
{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign heading_id = 'PasswordTitle-' | append: section.id
  assign newsletter_heading_id = 'PasswordNewsletter-' | append: section.id
  assign newsletter_form_id = 'PasswordNewsletterForm-' | append: section.id
  assign password_form_id = 'PasswordForm-' | append: section.id

  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'password.title' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'password.heading' | t
  endif
  assign newsletter_heading = section.settings.newsletter_heading
  if newsletter_heading == blank
    assign newsletter_heading = 'password.newsletter.heading' | t
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    --password-logo-width: {{ settings.logo_width }}px;
  }
{% endstyle %}

<section
  class="section content-password scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ heading_id }}"
  data-testid="password-page"
>
  <div class="page-width content-password__frame">
    <header class="content-password__top">
      {%- if settings.logo != blank -%}
        {%- liquid
          assign logo_width_2x = settings.logo_width | times: 2
          assign logo_sizes = settings.logo_width | append: 'px'
        -%}
        {{
          settings.logo
          | image_url: width: logo_width_2x
          | image_tag:
            class: 'content-password__logo',
            alt: shop.name,
            loading: 'eager',
            widths: '120, 240, 360, 520',
            sizes: logo_sizes
        }}
      {%- else -%}
        <p class="content-password__shop">{{ shop.name | escape }}</p>
      {%- endif -%}
      <div class="tri-stripe content-password__stripe" aria-hidden="true"><span></span></div>
    </header>

    <div class="content-password__main">
      <p class="eyebrow eyebrow--rule">{{ eyebrow | escape }}</p>
      <h1 id="{{ heading_id }}" class="content-password__title {{ section.settings.heading_size }}">{{ heading | escape }}</h1>
      {%- if shop.password_message != blank -%}
        <p class="content-password__message">{{ shop.password_message | escape }}</p>
      {%- endif -%}

      {%- if section.settings.show_newsletter -%}
        <div class="content-password__newsletter">
          <h2 id="{{ newsletter_heading_id }}" class="content-password__newsletter-title label-mono">
            {{- newsletter_heading | escape -}}
          </h2>
          {%- form 'customer', id: newsletter_form_id, class: 'content-form content-password__form', data-testid: 'password-newsletter' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            {%- if form.posted_successfully? -%}
              <div class="form-message form-message--success" role="status">
                {% render 'icon', name: 'check' %}
                <p>{{ 'password.newsletter.success' | t }}</p>
              </div>
            {%- elsif form.errors -%}
              <div class="form-message form-message--error" role="alert" id="{{ newsletter_form_id }}-error">
                {% render 'icon', name: 'alert' %}
                <p>
                  {%- for field in form.errors -%}
                    {%- if field == 'form' -%}
                      {{ form.errors.messages[field] }}
                    {%- else -%}
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    {%- endif -%}
                    {%- unless forloop.last %} {% endunless -%}
                  {%- endfor -%}
                </p>
              </div>
            {%- endif -%}
            <div class="content-password__row">
              <div class="field">
                <label class="field__label" for="{{ newsletter_form_id }}-email">{{ 'password.newsletter.label' | t }}</label>
                <input
                  class="field__input"
                  type="email"
                  id="{{ newsletter_form_id }}-email"
                  name="contact[email]"
                  autocomplete="email"
                  spellcheck="false"
                  autocapitalize="off"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="{{ newsletter_form_id }}-error"
                  {% endif %}
                >
              </div>
              <button type="submit" class="button">{{ 'password.newsletter.submit' | t }}</button>
            </div>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <footer class="content-password__bottom">
      {%- form 'storefront_password', id: password_form_id, class: 'content-password__owner' -%}
        <details
          class="content-password__details"
          {% if form.errors %}
            open
          {% endif %}
        >
          <summary class="content-password__summary link-mono">
            {% render 'icon', name: 'lock' %}
            <span>{{ 'password.owner_summary' | t }}</span>
          </summary>
          <div class="content-password__login content-form">
            {%- if form.errors -%}
              <div class="form-message form-message--error" role="alert" id="{{ password_form_id }}-error">
                {% render 'icon', name: 'alert' %}
                <p>{{ 'password.error' | t }}</p>
              </div>
            {%- endif -%}
            <div class="content-password__row">
              <div class="field">
                <label class="field__label" for="{{ password_form_id }}-input">{{ 'password.password' | t }}</label>
                <input
                  class="field__input"
                  type="password"
                  id="{{ password_form_id }}-input"
                  name="password"
                  autocomplete="current-password"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="{{ password_form_id }}-error"
                  {% endif %}
                >
              </div>
              <button type="submit" class="button button--ink">{{ 'password.enter' | t }}</button>
            </div>
          </div>
        </details>
      {%- endform -%}
      <p class="content-password__copyright label-mono">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | escape }}</p>
    </footer>
  </div>
</section>

{% schema %}
{
  "name": "Passwortseite",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label über der Überschrift",
      "info": "Leer lassen für den Standardtext."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "info": "Leer lassen für den Standardtext. Die Nachricht selbst pflegst du unter Onlineshop › Einstellungen."
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Größe der Überschrift",
      "options": [
        { "value": "h1", "label": "Mittel" },
        { "value": "h-display", "label": "Groß (Display)" }
      ],
      "default": "h-display"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Newsletter-Anmeldung anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Überschrift Newsletter",
      "info": "Leer lassen für den Standardtext."
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    }
  ]
}
{% endschema %}
