{% doc %}
  Cart item count badge. Re-rendered through the `cart-count` section after cart mutations.

  @example
  {% render 'cart-count' %}
{% enddoc %}

<span class="cart-count{% if cart.item_count == 0 %} cart-count--empty{% endif %}" data-cart-count>
  <span class="cart-count__number" aria-hidden="true">{{ cart.item_count }}</span>
  <span class="visually-hidden">{{ 'cart.count' | t: count: cart.item_count }}</span>
</span>
