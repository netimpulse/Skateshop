{%- comment -%}
  Product details as an accordion (native <details>): description, features (custom.features), size guide,
  shipping and custom panels. Panels without content are skipped.
{%- endcomment -%}

{{ 'section-product.css' | asset_url | stylesheet_tag }}
{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign heading_id = 'Heading-' | append: section.id
  assign default_eyebrow = 'products.details.eyebrow' | t
  assign eyebrow = section.settings.eyebrow | default: default_eyebrow
  unless section.settings.show_eyebrow
    assign eyebrow = blank
  endunless
  assign default_heading = 'products.details.heading' | t
  assign heading = section.settings.heading | default: default_heading
  assign panel_index = 0
-%}

<section
  class="section product-details scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width product-details__grid">
    <div class="product-details__intro">
      {% render 'section-heading',
        eyebrow: eyebrow,
        heading: heading,
        heading_id: heading_id,
        heading_class: 'h3'
      %}
    </div>

    <div class="product-details__list" data-testid="product-details">
      {%- for block in section.blocks -%}
        {%- liquid
          assign title = block.settings.heading
          assign content = ''
          assign page_link = blank

          case block.type
            when 'details'
              assign default_title = 'products.details.description' | t
              assign title = title | default: default_title
              assign content = product.description
            when 'features'
              assign default_title = 'products.details.features' | t
              assign title = title | default: default_title
              assign features = product.metafields.custom.features.value
              if features != blank
                capture content
                  echo '<ul class="product-details__features" role="list">'
                  for feature in features
                    echo '<li><span class="product-details__feature-index" aria-hidden="true">'
                    if forloop.index < 10
                      echo '0'
                    endif
                    echo forloop.index
                    echo '</span><span>'
                    echo feature | escape
                    echo '</span></li>'
                  endfor
                  echo '</ul>'
                endcapture
              else
                assign content = block.settings.content
              endif
            when 'size_guide'
              assign default_title = 'products.details.size_guide' | t
              assign title = title | default: default_title
              if block.settings.page != blank
                assign content = block.settings.page.content
                assign page_link = block.settings.page.url
              elsif block.settings.content != blank
                assign content = block.settings.content
              else
                assign guide_page = pages['groessenberatung']
                if guide_page.content != blank
                  assign content = guide_page.content
                  assign page_link = guide_page.url
                endif
              endif
            when 'shipping'
              assign default_title = 'products.details.shipping' | t
              assign title = title | default: default_title
              if block.settings.content != blank
                assign content = block.settings.content
              elsif block.settings.page != blank
                assign content = block.settings.page.content
                assign page_link = block.settings.page.url
              elsif shop.shipping_policy.body != blank
                assign content = shop.shipping_policy.body
                assign page_link = shop.shipping_policy.url
              else
                assign shipping_page = pages['versand']
                if shipping_page.content != blank
                  assign content = shipping_page.content
                  assign page_link = shipping_page.url
                endif
              endif
            when 'custom'
              if block.settings.content != blank
                assign content = block.settings.content
              elsif block.settings.page != blank
                assign content = block.settings.page.content
                assign page_link = block.settings.page.url
              endif
          endcase
        -%}

        {%- if title != blank and content != blank -%}
          {%- assign panel_index = panel_index | plus: 1 -%}
          <details
            class="product-details__item product-details__item--{{ block.type }}"
            id="ProductDetails-{{ block.id }}"
            {% if block.settings.open %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="product-details__summary">
              <span class="product-details__index label-mono" aria-hidden="true">
                {%- if panel_index < 10 -%}0{%- endif -%}
                {{- panel_index -}}
              </span>
              <h3 class="product-details__title">{{ title | escape }}</h3>
              <span class="product-details__icon" aria-hidden="true">{% render 'icon', name: 'plus' %}</span>
            </summary>
            <div class="product-details__content rte">
              {{ content }}
              {%- if page_link != blank -%}
                <p class="product-details__more">
                  <a class="link-mono" href="{{ page_link }}">{{ 'products.details.read_more' | t }}</a>
                </p>
              {%- endif -%}
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="module" src="{{ 'product.js' | asset_url }}"></script>

{% schema %}
{
  "name": "Produktdetails",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Label über der Überschrift anzeigen",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Label-Text",
      "info": "Leer = Standardtext"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "info": "Leer = Standardtext „Produktdetails“"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "details",
      "name": "Produktbeschreibung",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "info": "Leer = Standardtext"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": true
        }
      ]
    },
    {
      "type": "features",
      "name": "Features",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Liest die Liste aus dem Produkt-Metafield custom.features. Ohne Metafield wird der Text unten genutzt."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "info": "Leer = Standardtext"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Ersatztext"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": false
        }
      ]
    },
    {
      "type": "size_guide",
      "name": "Größenberatung",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "info": "Leer = Standardtext"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Seite",
          "info": "Leer = Text unten, sonst Seite „groessenberatung“"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": false
        }
      ]
    },
    {
      "type": "shipping",
      "name": "Versand & Rückgabe",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "info": "Leer = Standardtext"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text",
          "info": "Leer = gewählte Seite, sonst Versandrichtlinie des Shops, sonst Seite „versand“"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Seite"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": false
        }
      ]
    },
    {
      "type": "custom",
      "name": "Eigenes Panel",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Überschrift",
          "default": "Pflege & Tipps"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Text"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Oder Seite",
          "info": "Wird genutzt, wenn der Text leer ist."
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Standardmäßig geöffnet",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produktdetails",
      "blocks": [
        { "type": "details" },
        { "type": "features" },
        { "type": "size_guide" },
        { "type": "shipping" }
      ]
    }
  ]
}
{% endschema %}
