{%- comment -%}
  Board builder promo: "YOUR BOARD. YOUR RULES." heading, text, CTA, numbered step list (blocks)
  and either an image or the built-in parts blueprint (SVG, colours via classes).
{%- endcomment -%}
{{ 'section-builder-promo.css' | asset_url | stylesheet_tag }}
{% render 'section-style', section_id: section.id, padding_top: section.settings.padding_top, padding_bottom: section.settings.padding_bottom %}

{%- liquid
  assign s = section.settings
  assign heading_id = 'Heading-' | append: section.id

  assign cta_link = s.button_link
  if cta_link == blank
    assign cta_link = pages['skateboard-builder'].url
  endif

  assign classes = 'builder-promo--' | append: s.layout
  if s.enable_grain
    assign classes = classes | append: ' has-grain'
  endif

  assign step_names = ''
  for block in section.blocks
    assign step_name = block.settings.title | strip | replace: '|', '/'
    assign step_names = step_names | append: step_name | append: '|'
  endfor
  assign step_names = step_names | split: '|'
-%}

<section
  class="section builder-promo scheme color-{{ s.color_scheme }} {{ classes }}"
  data-section-id="{{ section.id }}"
  data-testid="home-builder-promo"
  aria-labelledby="{{ heading_id }}"
>
  <div class="page-width builder-promo__inner">
    <div class="builder-promo__copy">
      {%- if s.eyebrow != blank or s.index != blank -%}
        <p class="eyebrow eyebrow--rule builder-promo__eyebrow reveal">
          {%- if s.index != blank -%}
            <span class="eyebrow__index">{{ s.index | escape }}</span>
          {%- endif -%}
          {%- if s.eyebrow != blank -%}
            <span>{{ s.eyebrow | escape }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      <h2 class="builder-promo__title reveal" id="{{ heading_id }}" data-reveal-index="1">
        {%- if s.heading != blank -%}
          <span class="builder-promo__line">{{ s.heading | escape }}</span>
        {%- endif -%}
        {{ ' ' }}
        {%- if s.heading_accent != blank -%}
          <span class="builder-promo__line builder-promo__line--accent">{{ s.heading_accent | escape }}</span>
        {%- endif -%}
      </h2>

      <div class="builder-promo__body reveal" data-reveal-index="2">
        {%- if s.text != blank -%}
          <div class="builder-promo__text rte">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank and cta_link != blank -%}
          <a class="button builder-promo__button" href="{{ cta_link }}">
            {{- s.button_label | escape -}}
            {%- render 'icon', name: 'arrow-right' -%}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ol class="builder-promo__steps reveal" role="list" data-reveal-index="3">
          {%- for block in section.blocks -%}
            <li class="builder-promo__step" {{ block.shopify_attributes }}>
              <span class="builder-promo__step-no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="builder-promo__step-name">{{ block.settings.title | escape }}</span>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>

    <div class="builder-promo__figure{% if s.image != blank %} builder-promo__figure--image builder-promo__figure--{{ s.image_fit }}{% endif %}">
      {%- if s.enable_parallax -%}
        <parallax-media class="builder-promo__parallax" data-strength="24">
      {%- else -%}
        <div class="builder-promo__parallax">
      {%- endif -%}

      {%- if s.image != blank -%}
        {{
          s.image
          | image_url: width: 1800
          | image_tag:
            widths: '480, 720, 960, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 45vw, 100vw',
            loading: 'lazy',
            class: 'builder-promo__image',
            alt: s.image.alt
        }}
      {%- else -%}
        {%- liquid
          assign label_1 = '01 ' | append: step_names[0] | upcase | strip
          assign label_2 = '02 ' | append: step_names[1] | upcase | strip
          assign label_3 = '03 ' | append: step_names[2] | upcase | strip
          assign label_4 = '04 ' | append: step_names[3] | upcase | strip
          assign label_5 = '05 ' | append: step_names[4] | upcase | strip
          assign label_6 = '06 ' | append: step_names[5] | upcase | strip
        -%}
        <svg class="builder-promo__blueprint" viewBox="0 0 640 480" aria-hidden="true" focusable="false">
          {%- comment -%} 01 Deck – top view with dimension lines {%- endcomment -%}
          <path class="bp-line bp-dash bp-faint" d="M60 95H560"/>
          <path class="bp-line" d="M115 40H505A55 55 0 0 1 505 150H115A55 55 0 0 1 115 40Z"/>
          <path class="bp-line bp-dash bp-faint" d="M150 44V146M470 44V146"/>
          <g class="bp-line">
            <circle cx="172" cy="80" r="3"/><circle cx="172" cy="110" r="3"/><circle cx="202" cy="80" r="3"/><circle cx="202" cy="110" r="3"/>
            <circle cx="418" cy="80" r="3"/><circle cx="418" cy="110" r="3"/><circle cx="448" cy="80" r="3"/><circle cx="448" cy="110" r="3"/>
          </g>
          <path class="bp-line bp-accent" d="M60 22H560M60 16V28M560 16V28M584 40V150M578 40H590M578 150H590"/>
          <text class="bp-text bp-text--accent" x="310" y="12" text-anchor="middle">32″</text>
          <text class="bp-text bp-text--accent" x="594" y="99">8.25″</text>

          {%- comment -%} 02 Trucks – front view {%- endcomment -%}
          <g class="bp-line">
            <path d="M96 196H164V204H96Z"/><path d="M120 204H140V216H120Z"/>
            <path d="M74 216H186L170 240Q130 254 90 240Z"/>
            <path d="M58 228H202"/><path d="M50 222H58V234H50ZM202 222H210V234H202Z"/>
            <path d="M256 196H324V204H256Z"/><path d="M280 204H300V216H280Z"/>
            <path d="M234 216H346L330 240Q290 254 250 240Z"/>
            <path d="M218 228H362"/><path d="M210 222H218V234H210ZM362 222H370V234H362Z"/>
          </g>
          <circle class="bp-dot" cx="130" cy="210" r="3"/>

          {%- comment -%} 03 Wheels {%- endcomment -%}
          <g class="bp-line">
            <circle cx="420" cy="224" r="24"/><circle cx="420" cy="224" r="10"/>
            <circle cx="474" cy="224" r="24"/><circle cx="474" cy="224" r="10"/>
            <circle cx="528" cy="224" r="24"/><circle cx="528" cy="224" r="10"/>
            <circle cx="582" cy="224" r="24"/><circle cx="582" cy="224" r="10"/>
          </g>
          <g class="bp-fill"><circle cx="420" cy="224" r="3"/><circle cx="474" cy="224" r="3"/><circle cx="528" cy="224" r="3"/><circle cx="582" cy="224" r="3"/></g>

          {%- comment -%} 04 Bearings {%- endcomment -%}
          <g class="bp-line">
            <circle cx="76" cy="334" r="14"/><circle cx="76" cy="334" r="6"/>
            <circle cx="112" cy="334" r="14"/><circle cx="112" cy="334" r="6"/>
            <circle cx="148" cy="334" r="14"/><circle cx="148" cy="334" r="6"/>
            <circle cx="184" cy="334" r="14"/><circle cx="184" cy="334" r="6"/>
            <circle cx="220" cy="334" r="14"/><circle cx="220" cy="334" r="6"/>
            <circle cx="256" cy="334" r="14"/><circle cx="256" cy="334" r="6"/>
            <circle cx="292" cy="334" r="14"/><circle cx="292" cy="334" r="6"/>
            <circle cx="328" cy="334" r="14"/><circle cx="328" cy="334" r="6"/>
          </g>
          <g class="bp-line bp-dash bp-faint">
            <circle cx="76" cy="334" r="10"/><circle cx="112" cy="334" r="10"/><circle cx="148" cy="334" r="10"/><circle cx="184" cy="334" r="10"/>
            <circle cx="220" cy="334" r="10"/><circle cx="256" cy="334" r="10"/><circle cx="292" cy="334" r="10"/><circle cx="328" cy="334" r="10"/>
          </g>

          {%- comment -%} 05 Grip – sheet with grit dots {%- endcomment -%}
          <path class="bp-line" d="M396 306H604V414H396Z"/>
          <g class="bp-fill bp-faint">
            <circle cx="412" cy="322" r="1.2"/><circle cx="440" cy="336" r="1.2"/><circle cx="468" cy="318" r="1.2"/><circle cx="498" cy="340" r="1.2"/>
            <circle cx="528" cy="324" r="1.2"/><circle cx="556" cy="344" r="1.2"/><circle cx="586" cy="326" r="1.2"/><circle cx="424" cy="360" r="1.2"/>
            <circle cx="452" cy="378" r="1.2"/><circle cx="484" cy="364" r="1.2"/><circle cx="512" cy="386" r="1.2"/><circle cx="540" cy="368" r="1.2"/>
            <circle cx="570" cy="392" r="1.2"/><circle cx="594" cy="372" r="1.2"/><circle cx="416" cy="398" r="1.2"/><circle cx="446" cy="402" r="1.2"/>
            <circle cx="476" cy="396" r="1.2"/><circle cx="506" cy="354" r="1.2"/><circle cx="560" cy="404" r="1.2"/><circle cx="530" cy="404" r="1.2"/>
          </g>
          <path class="bp-line bp-accent" d="M396 306L420 330"/>

          {%- comment -%} 06 Hardware – bolts {%- endcomment -%}
          <g class="bp-line">
            <path d="M68 396H88V402H68ZM75 402H81V436H75Z"/>
            <path d="M108 396H128V402H108ZM115 402H121V436H115Z"/>
            <path d="M148 396H168V402H148ZM155 402H161V436H155Z"/>
            <path d="M188 396H208V402H188ZM195 402H201V436H195Z"/>
          </g>
          <g class="bp-line">
            <path d="M236 414l8-5 8 5v10l-8 5-8-5Z"/><path d="M266 414l8-5 8 5v10l-8 5-8-5Z"/>
          </g>

          {%- comment -%} Callouts {%- endcomment -%}
          <g class="bp-dot">
            <circle cx="64" cy="172" r="3"/><circle cx="64" cy="280" r="3"/><circle cx="400" cy="280" r="3"/>
            <circle cx="64" cy="370" r="3"/><circle cx="400" cy="434" r="3"/><circle cx="64" cy="462" r="3"/>
          </g>
          <g class="bp-text">
            <text x="74" y="176">{{ label_1 | escape }}</text>
            <text x="74" y="284">{{ label_2 | escape }}</text>
            <text x="410" y="284">{{ label_3 | escape }}</text>
            <text x="74" y="374">{{ label_4 | escape }}</text>
            <text x="410" y="438">{{ label_5 | escape }}</text>
            <text x="74" y="466">{{ label_6 | escape }}</text>
          </g>
        </svg>
      {%- endif -%}

      {%- if s.enable_parallax -%}
        </parallax-media>
      {%- else -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Builder-Promo",
  "class": "section-builder-promo",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "index",
      "label": "Rubrik-Nummer",
      "default": "03"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Rubrik",
      "default": "Konfigurator"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift – Teil 1",
      "default": "YOUR BOARD."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Überschrift – Teil 2 (Akzent)",
      "default": "YOUR RULES."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Deck wählen, Achsen passend zur Breite, Rollen nach Härte – der Builder prüft jede Kombination und legt alles in einem Schritt in den Warenkorb.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "START BUILDING"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link",
      "info": "Leer = Seite mit dem Handle „skateboard-builder“."
    },
    {
      "type": "header",
      "content": "Bild"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild",
      "info": "Leer = eingebaute Teile-Zeichnung mit den Schritt-Namen."
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Bilddarstellung",
      "options": [
        { "value": "cover", "label": "Fläche füllen" },
        { "value": "contain", "label": "Ganz zeigen" }
      ],
      "default": "contain"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "Leichte Parallax-Bewegung",
      "default": false
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Grafik auf Desktop",
      "options": [
        { "value": "figure-right", "label": "Rechts" },
        { "value": "figure-left", "label": "Links" }
      ],
      "default": "figure-right"
    },
    {
      "type": "checkbox",
      "id": "enable_grain",
      "label": "Körnung (Grain)",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Deck"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Builder-Promo",
      "blocks": [
        { "type": "step", "settings": { "title": "Deck" } },
        { "type": "step", "settings": { "title": "Trucks" } },
        { "type": "step", "settings": { "title": "Wheels" } },
        { "type": "step", "settings": { "title": "Bearings" } },
        { "type": "step", "settings": { "title": "Grip" } },
        { "type": "step", "settings": { "title": "Hardware" } }
      ]
    }
  ]
}
{% endschema %}
