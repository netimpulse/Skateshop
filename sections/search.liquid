{%- comment -%}
  Search page: H1, search form, result count, product results with the same filters/sorting as collections
  (search.filters, snippets facet-layout / filter-sidebar / filter-chips / pagination), pages & articles as a list,
  empty state with category suggestions. search.terms is always escaped.
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{%- if search.performed -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script type="module" src="{{ 'facets.js' | asset_url }}"></script>
{%- endif -%}

{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  assign terms_escaped = search.terms | escape
  if section.settings.heading != blank
    assign heading = section.settings.heading
  else
    assign heading = 'search.title' | t
  endif

  assign columns_desktop = section.settings.columns_desktop | plus: 0
  if columns_desktop == 4
    assign card_sizes = '(min-width: 1200px) 260px, (min-width: 990px) 28vw, (min-width: 750px) 33vw, 50vw'
  else
    assign card_sizes = '(min-width: 1200px) 340px, (min-width: 990px) 28vw, (min-width: 750px) 33vw, 50vw'
  endif

  assign has_active_filters = false
  for filter in search.filters
    if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
      assign has_active_filters = true
      break
    endif
  endfor

  assign show_results = false
  if search.performed
    if search.results_count > 0 or has_active_filters
      assign show_results = true
    endif
  endif
-%}

{%- capture suggestions -%}
  {%- liquid
    assign suggestion_count = 0
    if section.settings.suggestions != blank
      assign suggestion_source = section.settings.suggestions
    else
      assign suggestion_source = collections
    endif
  -%}
  {%- for item in suggestion_source -%}
    {%- liquid
      if item.handle == 'frontpage' or item.handle == 'all' or item.handle contains 'builder-'
        continue
      endif
      if item.all_products_count == 0
        continue
      endif
      assign suggestion_count = suggestion_count | plus: 1
      if suggestion_count > 8
        break
      endif
    -%}
    <li>
      <a class="search-suggestions__link" href="{{ item.url }}">
        <span>{{ item.title | escape }}</span>
        {%- render 'icon', name: 'arrow-right' -%}
      </a>
    </li>
  {%- endfor -%}
{%- endcapture -%}

<section
  class="section search-main scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="SearchHeading-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs', class: 'search-main__breadcrumbs' %}
    {%- endif -%}

    <header class="search-main__header">
      <h1 class="search-main__title h1" id="SearchHeading-{{ section.id }}">{{ heading }}</h1>

      <form class="search-main__form" action="{{ routes.search_url }}" method="get" role="search" data-testid="search-form">
        <label class="field__label" for="SearchInput-{{ section.id }}">{{ 'search.label' | t }}</label>
        <div class="search-main__field">
          <input
            class="field__input search-main__input"
            type="search"
            id="SearchInput-{{ section.id }}"
            name="q"
            value="{{ terms_escaped }}"
            placeholder="{{ 'search.placeholder' | t }}"
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="button search-main__submit">
            {%- render 'icon', name: 'search' -%}
            <span>{{ 'search.submit' | t }}</span>
          </button>
        </div>
      </form>
    </header>

    {%- if show_results -%}
      {%- paginate search.results by section.settings.results_per_page -%}
        {%- liquid
          assign count_label = 'search.results.count' | t: count: search.results_count
          assign for_label = 'search.results.for_html' | t: terms: terms_escaped
          assign count_label = count_label | append: ' ' | append: for_label

          assign sort_by = search.sort_by | default: search.default_sort_by
          assign encoded_terms = search.terms | url_encode
          assign clear_url = routes.search_url | append: '?q=' | append: encoded_terms | append: '&options%5Bprefix%5D=last'
          if search.sort_by != blank
            assign clear_url = clear_url | append: '&sort_by=' | append: search.sort_by
          endif
          assign results_heading = 'search.results.heading' | t
          assign product_total = 0
          assign other_total = 0
          for result in search.results
            if result.object_type == 'product'
              assign product_total = product_total | plus: 1
            else
              assign other_total = other_total | plus: 1
            endif
          endfor
        -%}

        {%- capture results -%}
          {%- if search.results_count == 0 -%}
            <div class="collection-empty" data-testid="search-empty">
              <h3 class="collection-empty__title">{{ 'collections.empty_filtered' | t }}</h3>
              <p class="collection-empty__text">{{ 'collections.empty_filtered_hint' | t }}</p>
              <a class="button button--secondary" href="{{ clear_url }}" data-facets-link>{{ 'filters.reset_all' | t }}</a>
            </div>
          {%- endif -%}

          {%- if product_total > 0 -%}
            <ul
              class="grid collection-grid collection-grid--desktop-{{ columns_desktop }} collection-grid--mobile-2"
              role="list"
              data-testid="product-grid"
            >
              {%- for result in search.results -%}
                {%- if result.object_type == 'product' -%}
                  <li class="collection-grid__item">
                    {%- render 'product-card', product: result, sizes: card_sizes, index: forloop.index -%}
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if other_total > 0 -%}
            <div class="search-other" data-testid="search-other">
              <h3 class="search-other__heading">{{ 'search.results.pages' | t }}</h3>
              <ul class="search-other__list" role="list">
                {%- for result in search.results -%}
                  {%- if result.object_type == 'product' -%}
                    {%- continue -%}
                  {%- endif -%}
                  {%- liquid
                    if result.object_type == 'article'
                      assign type_label = 'search.results.type_article' | t
                      assign excerpt = result.excerpt_or_content | strip_html | truncatewords: 26
                    else
                      assign type_label = 'search.results.type_page' | t
                      assign excerpt = result.content | strip_html | truncatewords: 26
                    endif
                  -%}
                  <li>
                    <a class="search-other__link" href="{{ result.url }}">
                      <span class="search-other__type">{{ type_label }}</span>
                      <span class="search-other__title">{{ result.title | escape }}</span>
                      {%- if excerpt != blank -%}
                        <span class="search-other__excerpt">{{ excerpt }}</span>
                      {%- endif -%}
                      {%- render 'icon', name: 'arrow-right', class: 'search-other__arrow' -%}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endcapture -%}

        {%- render 'facet-layout',
          section_id: section.id,
          filters: search.filters,
          action_url: routes.search_url,
          clear_url: clear_url,
          results: results,
          results_heading: results_heading,
          count_label: count_label,
          count: search.results_count,
          paginate: paginate,
          enable_filtering: section.settings.enable_filtering,
          enable_sorting: section.settings.enable_sorting,
          sort_options: search.sort_options,
          sort_by: sort_by,
          expand: section.settings.filters_expanded,
          show_counts: section.settings.show_filter_counts,
          terms: search.terms
        -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="search-empty" data-testid="search-empty">
        {%- if search.performed -%}
          <h2 class="search-empty__title h3">{{ 'search.no_results_html' | t: terms: terms_escaped }}</h2>
          <p class="search-empty__text">{{ 'search.empty_hint' | t }}</p>
        {%- else -%}
          <h2 class="search-empty__title h3">{{ 'search.intro' | t }}</h2>
        {%- endif -%}

        {%- if suggestions != blank -%}
          <div class="search-suggestions">
            <h3 class="search-suggestions__heading">{{ 'search.suggestions' | t }}</h3>
            <ul class="search-suggestions__list" role="list">
              {{ suggestions }}
            </ul>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Suchergebnisse",
  "enabled_on": {
    "templates": ["search"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "info": "Leer lassen für „Suche“."
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Brotkrumen anzeigen",
      "default": true
    },
    {
      "type": "range",
      "id": "results_per_page",
      "label": "Ergebnisse pro Seite",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Spalten Desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "header",
      "content": "Filter & Sortierung"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Filter anzeigen",
      "default": true
    },
    {
      "type": "select",
      "id": "filters_expanded",
      "label": "Aufgeklappte Filtergruppen (Desktop)",
      "options": [
        { "value": "all", "label": "Alle" },
        { "value": "first", "label": "Die ersten drei" },
        { "value": "active", "label": "Nur aktive" }
      ],
      "default": "first",
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    {
      "type": "checkbox",
      "id": "show_filter_counts",
      "label": "Anzahl je Filterwert zeigen",
      "default": true,
      "visible_if": "{{ section.settings.enable_filtering }}"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Sortierung anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Leerzustand"
    },
    {
      "type": "collection_list",
      "id": "suggestions",
      "label": "Vorgeschlagene Kategorien",
      "info": "Leer lassen, um automatisch Kategorien mit Produkten zu zeigen.",
      "limit": 8
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
