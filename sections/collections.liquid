{%- comment -%}
  Collection overview (list-collections template): breadcrumbs, H1 and a tile grid of all collections
  (image or skate placeholder, title, product count). Builder collections (builder-*) and excluded handles are skipped.
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}

{% render 'section-style',
  section_id: section.id,
  padding_top: section.settings.padding_top,
  padding_bottom: section.settings.padding_bottom
%}

{%- liquid
  if section.settings.heading != blank
    assign heading = section.settings.heading
  else
    assign heading = 'collections.title' | t
  endif

  assign exclude_list = section.settings.exclude_handles | remove: ' ' | split: ','
  assign list = collections
  case section.settings.sort
    when 'alphabetical'
      assign list = collections | sort_natural: 'title'
    when 'products_high'
      assign list = collections | sort: 'all_products_count' | reverse
  endcase

  assign columns_desktop = section.settings.columns_desktop | plus: 0
  assign columns_mobile = section.settings.columns_mobile | plus: 0
  if columns_mobile == 1
    assign tile_sizes = '(min-width: 990px) 30vw, (min-width: 750px) 50vw, 100vw'
  else
    assign tile_sizes = '(min-width: 990px) 30vw, (min-width: 750px) 50vw, 50vw'
  endif
  assign tile_index = 0
-%}

<section
  class="section collections-list scheme color-{{ section.settings.color_scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="CollectionsHeading-{{ section.id }}"
>
  <div class="page-width">
    {%- if section.settings.show_breadcrumbs -%}
      {% render 'breadcrumbs', class: 'collections-list__breadcrumbs' %}
    {%- endif -%}

    <header class="collections-list__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow eyebrow--rule">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="collections-list__title h1" id="CollectionsHeading-{{ section.id }}">{{ heading }}</h1>
      {%- if section.settings.text != blank -%}
        <div class="collections-list__text rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </header>

    {%- capture tiles -%}
      {%- for item in list -%}
        {%- liquid
          if exclude_list contains item.handle
            continue
          endif
          if section.settings.hide_builder and item.handle contains 'builder-'
            continue
          endif
          if section.settings.hide_empty and item.all_products_count == 0
            continue
          endif
          assign tile_index = tile_index | plus: 1

          case item.handle
            when 'decks'
              assign kind = 'deck'
            when 'trucks', 'wheels', 'bearings', 'griptape', 'hardware'
              assign kind = item.handle
            when 'risers', 'riser-pads'
              assign kind = 'riser'
            when 'completes', 'complete-skateboards'
              assign kind = 'complete'
            else
              assign kind = 'generic'
          endcase
          assign tile_count = 'collections.product_count' | t: count: item.all_products_count
          assign tile_number = tile_index | prepend: '0' | slice: -2, 2
        -%}
        <li class="collection-tile reveal" data-reveal-index="{{ tile_index | modulo: 4 }}">
          <a class="collection-tile__link" href="{{ item.url }}">
            <div class="collection-tile__visual" aria-hidden="true">
              {%- if item.featured_image -%}
                {% render 'image',
                  image: item.featured_image,
                  sizes: tile_sizes,
                  ratio: section.settings.image_ratio,
                  class: 'collection-tile__media'
                %}
              {%- else -%}
                <div class="media collection-tile__media" data-ratio="{{ section.settings.image_ratio | handleize }}">
                  {% render 'placeholder-skate', kind: kind, label: item.title %}
                </div>
              {%- endif -%}
            </div>
            <span class="collection-tile__body">
              <span class="collection-tile__index" aria-hidden="true">{{ tile_number }}</span>
              <span class="collection-tile__title">{{ item.title | escape }}</span>
              <span class="collection-tile__count">{{ tile_count }}</span>
              {%- render 'icon', name: 'arrow-right', class: 'collection-tile__arrow' -%}
            </span>
          </a>
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if tile_index > 0 -%}
      <ul
        class="grid collections-list__grid collections-list__grid--desktop-{{ columns_desktop }} collections-list__grid--mobile-{{ columns_mobile }}"
        role="list"
        data-testid="collection-list"
      >
        {{ tiles }}
      </ul>
    {%- else -%}
      <p class="collections-list__empty">{{ 'collections.list_empty' | t }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Kategorie-Übersicht",
  "enabled_on": {
    "templates": ["list-collections"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kicker",
      "default": "Shop"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "info": "Leer lassen für „Kategorien“."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Brotkrumen anzeigen",
      "default": true
    },
    {
      "type": "header",
      "content": "Kacheln"
    },
    {
      "type": "select",
      "id": "sort",
      "label": "Reihenfolge",
      "options": [
        { "value": "default", "label": "Wie im Admin" },
        { "value": "alphabetical", "label": "Alphabetisch" },
        { "value": "products_high", "label": "Meiste Produkte zuerst" }
      ],
      "default": "default"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Bildformat",
      "options": [
        { "value": "4 / 5", "label": "Hochformat (4:5)" },
        { "value": "1 / 1", "label": "Quadrat" },
        { "value": "4 / 3", "label": "Querformat (4:3)" }
      ],
      "default": "4 / 3"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Spalten Desktop",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Spalten Mobil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Leere Kategorien ausblenden",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "hide_builder",
      "label": "Builder-Collections (builder-*) ausblenden",
      "default": true
    },
    {
      "type": "text",
      "id": "exclude_handles",
      "label": "Weitere Handles ausblenden",
      "info": "Kommagetrennt, z. B. frontpage, all",
      "default": "frontpage, all"
    },
    {
      "type": "header",
      "content": "Darstellung"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ]
}
{% endschema %}
