{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkbank/secret-guard.js\" --claude-hook",
            "timeout": 10
          }
        ],
        "matcher": "Write|Edit|MultiEdit"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/werkbank/session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "env": {
    "WERKBANK_CODEX": "aus"
  }
}
