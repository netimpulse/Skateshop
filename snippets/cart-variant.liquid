{% doc %}
  Variant options of a cart line ("Breite: 8.25 · Farbe: Schwarz"). Renders nothing for default-only variants
  ("Default Title") so single-variant products stay clean.

  @param {object} item - Cart line item
  @param {string} [class] - CSS class of the paragraph

  @example
  {% render 'cart-variant', item: item, class: 'cart-item__variant' %}
{% enddoc %}

{%- liquid
  assign parts = ''
  unless item.product.has_only_default_variant
    for option in item.options_with_values
      if option.name == 'Title' or option.value == 'Default Title'
        continue
      endif
      assign option_value = option.value | escape
      assign pair = option.name | escape | append: ': ' | append: option_value
      if parts == ''
        assign parts = pair
      else
        assign parts = parts | append: ' · ' | append: pair
      endif
    endfor
  endunless
-%}

{%- if parts != '' -%}
  <p class="{{ class }}">{{ parts }}</p>
{%- endif -%}
