{%- comment -%}
  Brand marquee: names (or logos) from shop.vendors or from "brand" blocks, running in a pausable <marquee-strip>.
  The second copy of the track is aria-hidden with unfocusable links; with reduced motion the list wraps statically.
  Short lists are repeated so that one copy of the track is always wider than the viewport.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign heading_id = 'Heading-' | append: section.id

  if s.source == 'vendors'
    assign brand_count = shop.vendors.size
    if brand_count > 40
      assign brand_count = 40
    endif
  else
    assign brand_count = section.blocks.size
  endif

  assign repeats = 1
  if brand_count < 4
    assign repeats = 4
  elsif brand_count < 8
    assign repeats = 2
  endif
-%}

{%- if brand_count > 0 or request.design_mode -%}
  {{ 'section-brand-marquee.css' | asset_url | stylesheet_tag }}
  {% render 'section-style', section_id: section.id, padding_top: s.padding_top, padding_bottom: s.padding_bottom %}
  {% style %}
    #shopify-section-{{ section.id }} {
      --marquee-duration: {{ s.duration }}s;
    }
  {% endstyle %}

  <section
    class="section brand-marquee brand-marquee--sep-{{ s.separator }} brand-marquee--{{ s.direction }} scheme color-{{ s.color_scheme }}"
    data-section-id="{{ section.id }}"
    data-testid="home-brand-marquee"
    aria-labelledby="{{ heading_id }}"
  >
    <marquee-strip class="brand-marquee__strip" data-testid="brand-marquee">
      <div class="brand-marquee__label">
        <h2 class="brand-marquee__heading label-mono" id="{{ heading_id }}">
          {%- if s.index != blank -%}
            <span class="eyebrow__index">{{ s.index | escape }}</span>
          {%- endif -%}
          <span>{{ s.heading | escape }}</span>
        </h2>
        {%- if s.show_count and brand_count > 0 -%}
          <p class="brand-marquee__count label-mono">{{ 'sections.marquee.count' | t: count: brand_count }}</p>
        {%- endif -%}
      </div>

      <div class="brand-marquee__viewport">
        {%- if brand_count > 0 -%}
          <div class="brand-marquee__track">
            {%- for copy in (1..2) -%}
              <ul
                class="brand-marquee__list{% if copy > 1 %} brand-marquee__list--clone{% endif %}"
                role="list"
                {% if copy > 1 %}
                  aria-hidden="true"
                {% endif %}
              >
                {%- for pass in (1..repeats) -%}
                  {%- liquid
                    assign hidden = false
                    if copy > 1 or pass > 1
                      assign hidden = true
                    endif
                  -%}
                  {%- if s.source == 'vendors' -%}
                    {%- for vendor in shop.vendors limit: 40 -%}
                      <li
                        class="brand-marquee__item{% if pass > 1 %} brand-marquee__item--repeat{% endif %}"
                        {% if hidden and copy == 1 %}
                          aria-hidden="true"
                        {% endif %}
                      >
                        {%- if s.link_brands -%}
                          <a
                            class="brand-marquee__name"
                            href="{{ vendor | url_for_vendor }}"
                            {% if hidden %}
                              tabindex="-1"
                            {% endif %}
                          >
                            {{- vendor | escape -}}
                          </a>
                        {%- else -%}
                          <span class="brand-marquee__name">{{ vendor | escape }}</span>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  {%- else -%}
                    {%- for block in section.blocks -%}
                      {%- liquid
                        assign brand = block.settings
                        assign brand_url = brand.link
                        if brand_url == blank and s.link_brands and brand.name != blank
                          assign brand_url = brand.name | url_for_vendor
                        endif
                      -%}
                      <li
                        class="brand-marquee__item{% if pass > 1 %} brand-marquee__item--repeat{% endif %}"
                        {% if hidden and copy == 1 %}
                          aria-hidden="true"
                        {% endif %}
                        {% unless hidden %}
                          {{ block.shopify_attributes }}
                        {% endunless %}
                      >
                        {%- capture brand_content -%}
                          {%- if brand.logo != blank -%}
                            {{
                              brand.logo
                              | image_url: height: 120
                              | image_tag: height: 40, loading: 'lazy', class: 'brand-marquee__logo', alt: brand.name
                            }}
                          {%- else -%}
                            {{ brand.name | escape }}
                          {%- endif -%}
                        {%- endcapture -%}
                        {%- if brand_url != blank -%}
                          <a
                            class="brand-marquee__name"
                            href="{{ brand_url }}"
                            {% if hidden %}
                              tabindex="-1"
                            {% endif %}
                          >
                            {{- brand_content -}}
                          </a>
                        {%- else -%}
                          <span class="brand-marquee__name">{{ brand_content }}</span>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endfor -%}
          </div>
        {%- else -%}
          <p class="brand-marquee__empty text-small text-muted">{{ 'sections.marquee.editor_empty' | t }}</p>
        {%- endif -%}
      </div>

      {%- if brand_count > 0 -%}
        <button
          type="button"
          class="brand-marquee__toggle icon-button"
          data-marquee-toggle
          data-testid="brand-marquee-toggle"
          aria-pressed="false"
          aria-label="{{ 'accessibility.pause_animation' | t }}"
        >
          {%- render 'icon', name: 'pause', class: 'brand-marquee__icon-pause' -%}
          {%- render 'icon', name: 'play', class: 'brand-marquee__icon-play' -%}
        </button>
      {%- endif -%}
    </marquee-strip>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Marken-Laufband",
  "class": "section-brand-marquee",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "index",
      "label": "Rubrik-Nummer",
      "default": "04"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Beschriftung",
      "default": "Marken"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Anzahl der Marken zeigen",
      "default": true
    },
    {
      "type": "select",
      "id": "source",
      "label": "Quelle",
      "options": [
        { "value": "vendors", "label": "Hersteller aller Produkte" },
        { "value": "blocks", "label": "Eigene Marken-Blocks" }
      ],
      "default": "vendors"
    },
    {
      "type": "checkbox",
      "id": "link_brands",
      "label": "Marken verlinken",
      "info": "Hersteller-Seite des Shops; bei Blocks hat ein eigener Link Vorrang.",
      "default": true
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Dauer eines Durchlaufs",
      "info": "Höher = langsamer.",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 45
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Richtung",
      "options": [
        { "value": "left", "label": "Nach links" },
        { "value": "right", "label": "Nach rechts" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Trennzeichen",
      "options": [
        { "value": "diamond", "label": "Raute" },
        { "value": "dot", "label": "Punkt" },
        { "value": "slash", "label": "Schrägstrich" },
        { "value": "none", "label": "Keins" }
      ],
      "default": "diamond"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Abstand oben",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Abstand unten",
      "min": 0,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marke",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Marke"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo (optional)",
          "info": "Ersetzt den Namen. Transparentes PNG/SVG, einfarbig."
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Marken-Laufband",
      "settings": {
        "source": "blocks"
      },
      "blocks": [
        { "type": "brand", "settings": { "name": "Nine Ply Co." } },
        { "type": "brand", "settings": { "name": "Quarry Lane" } },
        { "type": "brand", "settings": { "name": "Duskline" } },
        { "type": "brand", "settings": { "name": "Axlemoor" } },
        { "type": "brand", "settings": { "name": "Rolltype" } },
        { "type": "brand", "settings": { "name": "Swiftbore" } },
        { "type": "brand", "settings": { "name": "Gritfield" } },
        { "type": "brand", "settings": { "name": "Boltworks" } }
      ]
    }
  ]
}
{% endschema %}
